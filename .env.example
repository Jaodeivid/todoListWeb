# ========================================
# CONFIGURACIÓN DEL BACKEND
# ========================================
# Puerto en el que correrá el servidor backend
# (Por defecto: 3000)
PORT=3000

# URL de conexión a MongoDB
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/base_de_datos
# O local: mongodb://localhost:27017/todolistweb
# IMPORTANTE: Usar el mismo nombre de BD en ambos lados que está dentro de .gitignore
MONGODB=mongodb://localhost:27017/todolistweb

# Clave secreta para firmar JWT (JSON Web Tokens)
# Usar una cadena aleatoria segura de al menos 32 caracteres
# Ejemplo: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_super_segura_aqui_min_32_caracteres

# ========================================
# CONFIGURACIÓN DEL FRONTEND
# (Variablenes opcionales según necesidad)
# ========================================
# REACT_APP_API_URL=https://localhost:3000
